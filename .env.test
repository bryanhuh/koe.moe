# Deterministic, non-secret env for E2E (vite --mode test).
# Overrides .env.local during Playwright runs. All Supabase/source network
# is intercepted by the test mocks, so these values never reach a real server.
# The Supabase hostname's first label fixes the auth storage key the tests seed
# (sb-e2etest-auth-token).
VITE_SUPABASE_URL=https://e2etest.supabase.co
VITE_SUPABASE_ANON_KEY=e2e-anon-key
VITE_JAMENDO_CLIENT_ID=e2e-jamendo
