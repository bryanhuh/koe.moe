# Copy this file to .env.local and fill in your values.
# Supabase keys: Dashboard → Project Settings → API
# Resend key:   resend.com → API Keys

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Jamendo: register at https://devportal.jamendo.com for a free client_id
# Audius needs no key — its public discovery API is used directly
VITE_JAMENDO_CLIENT_ID=your-jamendo-client-id

# Not read by Vite — used as a reference when setting Supabase Edge Function secrets:
#   supabase secrets set RESEND_API_KEY=$RESEND_API_KEY SEND_EMAIL_HOOK_SECRET=$SEND_EMAIL_HOOK_SECRET --project-ref <ref>
RESEND_API_KEY=your-resend-api-key

# Send Email auth hook secret — Dashboard → Authentication → Hooks → Send Email
SEND_EMAIL_HOOK_SECRET=v1,whsec_your-hook-secret
