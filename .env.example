# Copy this file to .env.local and fill in your values.
# Supabase keys: Dashboard → Project Settings → API
# Resend key:   resend.com → API Keys

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Not read by Vite — used as a reference when setting Supabase Edge Function secrets:
#   supabase secrets set RESEND_API_KEY=$RESEND_API_KEY --project-ref <ref>
RESEND_API_KEY=your-resend-api-key
